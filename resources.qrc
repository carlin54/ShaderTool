        <file alias="wave_prefix_scan.json">resources/examples/subgroup/wave_prefix_scan.json</file>
    </qresource>
    <qresource prefix="/include">
        <file alias="host_catalog.hlsl">resources/include/host_catalog.hlsl</file>
    </qresource>
    <qresource prefix="/schema">
        <file alias="shaderproject.schema.json">schema/shaderproject.schema.json</file>
